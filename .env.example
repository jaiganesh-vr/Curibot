POSTGRES_PASSWORD=replace_with_local_database_password
JWT_SECRET_KEY=replace_with_a_secure_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
# Approximate tokens of conversation history sent to the model per turn.
CONTEXT_MAX_TOKENS=16000
# Optional web search (https://tavily.com). Leave empty to disable.
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
# Search rounds allowed per question before the assistant must answer.
WEB_SEARCH_MAX_ROUNDS=3
# Long-term memory of facts about each user across conversations.
MEMORY_ENABLED=true
# Logging: LOG_FORMAT is "json" (aggregation) or "text" (readable).
LOG_LEVEL=INFO
LOG_FORMAT=json
# Optional LangSmith tracing (https://smith.langchain.com). Off by default;
# unlike the logs, traces include message content.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=curibot
